# ---- Required in production ----
NEXT_PUBLIC_SITE_URL=https://www.vsmgodavarifoods.in

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Admin login — used ONLY for the very first sign-in (it creates the Owner login in the database).
# After that, change passwords and add partner logins in Admin → My account & logins (no redeploy needed).
# Forgot the owner password? Set ADMIN_RECOVERY=1, redeploy, sign in with this email/password, change it, then remove ADMIN_RECOVERY.
# ADMIN_RECOVERY=1
# Generate the hash with:  npm run hash-password -- "YourStrongPassword"
# (in this file every $ in the hash must be written as \$ — the command prints it that way)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# Database (free Turso / libSQL). Local dev works without these (uses ./data/vsm.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Optional: PhonePe Business automatic payments (via upipay SDK) ----
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1
# PHONEPE_ENV=sandbox   # change to production when live

# ---- Cloudinary (free) for product & category photos ----
# Cloudinary -> Settings -> API Keys. Keep the secret private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
